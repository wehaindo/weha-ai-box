{
  "name": "weha-ai-box",
  "version": "1.0.0",
  "private": true,
  "description": "WEHA AI Box — Agent Execution Platform",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev:runtime": "tsx watch src/main.ts",
    "dev:desktop": "concurrently -n next,electron -c blue,yellow \"next dev --port 3111\" \"wait-on http://localhost:3111 && cross-env NODE_ENV=development electron .\"",
    "dev": "concurrently -n runtime,desktop -c green,yellow \"npm run dev:runtime\" \"npm run dev:desktop\"",
    "build:next": "next build",
    "compile:electron": "tsc --project tsconfig.electron.json",
    "build:electron": "tsc --project tsconfig.electron.json && electron-builder",
    "build": "next build && tsc --project tsconfig.electron.json",
    "dist": "npm run build && npm run build:electron",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "db:generate": "prisma generate --config prisma/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "db:push": "prisma db push --config prisma/prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.x",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "fastify": "^5.x",
    "idb": "^8.0.3",
    "lucide-react": "^1.17.0",
    "next": "15.3.1",
    "pg": "^8.x",
    "pino": "^9.x",
    "pino-pretty": "^13.x",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serialport": "^13.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.x"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/pg": "^8.x",
    "@types/react": "^19.x",
    "@types/react-dom": "^19.x",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.x",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.x",
    "typescript": "^5.x",
    "vitest": "^3.x",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.weha.ai-box",
    "productName": "WEHA AI Box",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-dist/**",
      ".next/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "public/icon.png"
    }
  }
}
