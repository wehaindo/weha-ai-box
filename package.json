{
  "name": "weha-ai-box",
  "version": "1.0.0",
  "private": true,
  "description": "WEHA AI Box — Agent Execution Platform",
  "scripts": {
    "dev:runtime": "tsx watch src/main.ts",
    "dev:web": "next dev --port 3111",
    "dev": "concurrently -n runtime,web -c green,blue \"npm run dev:runtime\" \"npm run dev:web\"",
    "build:next": "next build",
    "build": "next build",
    "start:runtime": "tsx src/main.ts",
    "start:web": "next start -p 3000 -H 0.0.0.0",
    "start": "next start -p 3000 -H 0.0.0.0",
    "test": "vitest run",
    "db:generate": "prisma generate --config prisma/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "db:push": "prisma db push --config prisma/prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "simulate:whotif": "tsx scripts/simulate-whotif-message.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.x",
    "fastify": "^5.x",
    "framer-motion": "^12.42.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.17.0",
    "nats": "^2.29.3",
    "next": "15.3.1",
    "pg": "^8.x",
    "pino": "^9.x",
    "pino-pretty": "^13.x",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "serialport": "^13.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.x"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/pg": "^8.x",
    "@types/react": "^19.x",
    "@types/react-dom": "^19.x",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.x",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.x",
    "typescript": "^5.x",
    "vitest": "^3.x"
  }
}
