[Unit]
Description=WEHA AI Box Web Console (Next.js)
After=network.target
Wants=weha-runtime.service

[Service]
Type=simple
User=weha
WorkingDirectory=/opt/weha-ai-box
EnvironmentFile=/opt/weha-ai-box/.env
ExecStart=/usr/bin/node /opt/weha-ai-box/node_modules/.bin/next start -p 3000 -H 0.0.0.0
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
