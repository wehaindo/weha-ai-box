# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weha_ai_box

# Redis
REDIS_URL=redis://localhost:6379

# Runtime
RUNTIME_PORT=4000
RUNTIME_HOST=127.0.0.1
NODE_ENV=development

# JWT (local web console auth)
JWT_SECRET=change-me-to-a-random-secret-in-production

# Encryption key for credential vault
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# NATS + JetStream (WEHA Platform Gateway routing hub).
# Use the shared NATS the gateway + WHOTIF connect to; local docker = nats://localhost:4222
NATS_URL=nats://103.172.205.53:4222
NATS_USER=admin
NATS_PASS=adminpelang1

# LLM / AI Provider
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
#
# Optional fallback provider:
# LLM_FALLBACK_URL=
# LLM_FALLBACK_KEY=
# LLM_FALLBACK_MODEL=
#
# For Ollama (local):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
